# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------- database
#
# HOST and PORT here describe where things are *from your laptop*, which is what
# the scripts and a `uv run uvicorn` need. Inside `docker compose` the same
# database is `postgres:5432`, and compose overrides these three per service —
# see the anchor at the top of docker-compose.yml. Do not "fix" them to the
# container names or the shell workflow stops working.
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads
POSTGRES_DB=leads
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------- host ports
# Only read by docker-compose.yml, for the host side of each mapping. Change one
# if something else already owns the port.
# POSTGRES_PORT doubles as the Postgres host port (5433 above).
API_PORT=8000
FRONTEND_PORT=3000

# ---------------------------------------------------------------- storage
# Raw fetch archive (implementation.md §7 — "save every raw response")
RAW_ARCHIVE_DIR=./data/raw

# ---------------------------------------------------------------- proxy
# §7.1: a PK residential proxy is the ONE required paid input, and it is needed
# for CORRECTNESS not evasion — Google Maps geo-ranks results, so a non-PK egress
# IP returns the wrong businesses for a Lahore query.
#
# Leave PROXY_MODE=direct to develop without one. Every source except Google Maps
# (directories, PakPlay, Turfy, Zameen, business websites) works fine on direct.
# Set PROXY_MODE=residential and fill PROXY_URL when you have credentials.
PROXY_MODE=direct
PROXY_URL=
# Optional: comma-separated sources that MUST have a proxy. If PROXY_MODE=direct
# these sources refuse to run rather than silently returning wrong-country data.
PROXY_REQUIRED_SOURCES=google_maps

# ---------------------------------------------------------------- optional APIs
# §7.1: only needed if you switch the FB/IG toggles on.
SERP_API_KEY=
SERP_PROVIDER=serper

# §6.2 Tier 1. Free, but App Review takes weeks — start the application early.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# ---------------------------------------------------------------- pacing
# §7: reliability and politeness, not concealment.
CONCURRENCY=3
BROWSER_WORKERS=3
DELAY_MIN_SECONDS=3.0
DELAY_MAX_SECONDS=10.0
CACHE_TTL_LISTING_DAYS=7
CACHE_TTL_DETAIL_DAYS=30
DEDUPE_FUZZY_THRESHOLD=88
